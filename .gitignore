agent/keys/*.json
.env
# -----------------------------
# OS / Editor junk
# -----------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*.orig

# VS Code / JetBrains
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml

# -----------------------------
# Root-level logs & temp
# -----------------------------
*.log
logs/
tmp/
.cache/
coverage/

# -----------------------------
# Flutter / Dart (app/)
# -----------------------------
app/.dart_tool/
app/.packages
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.metadata
app/build/
app/ios/Flutter/flutter_export_environment.sh
app/ios/Pods/
app/ios/.symlinks/
app/ios/DerivedData/
app/ios/Runner/GeneratedPluginRegistrant.*
app/android/.gradle/
app/android/captures/
app/android/.cxx/
app/android/local.properties
app/web/.dart_tool/
# Keep firebase_options.dart committed (generated by flutterfire)
# app/lib/firebase_options.dart  <-- DO NOT ignore (commit this)

# -----------------------------
# Firebase / Emulators
# -----------------------------
.firebase/
firebase-debug.log
firestore_export/
# If you export emulator data or use local data dirs, ignore them:
**/emulator-data/
**/localdata/

# -----------------------------
# Firebase Functions (infra/functions)
# -----------------------------
infra/functions/node_modules/
infra/functions/lib/                # compiled JS from TypeScript
infra/functions/.runtimeconfig.json # firebase functions:config:get output
infra/functions/coverage/
infra/functions/npm-debug.log*
infra/functions/yarn-error.log*
# If you keep env files for local dev:
infra/functions/.env
infra/functions/.env.local
infra/functions/.env.*.local

# -----------------------------
# Python agent (agent/)
# -----------------------------
agent/.venv/
agent/venv/
agent/__pycache__/
agent/.pytest_cache/
agent/*.pyc
agent/*.pyo
agent/.mypy_cache/
agent/.ruff_cache/
agent/.DS_Store

# Secrets / keys (you already had these)
agent/keys/*.json
.env

# -----------------------------
# Platform-specific build artifacts
# -----------------------------
*.dll
*.so
*.dylib
*.exe

# -----------------------------
# Node / general JS
# -----------------------------
**/node_modules/
**/.npm/
**/.yarn/*
!**/.yarn/patches
!**/.yarn/releases
!**/.yarn/plugins
!**/.yarn/sdks
!**/.yarn/versions

# -----------------------------
# Misc
# -----------------------------
dist/
build/
